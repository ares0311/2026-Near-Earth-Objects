        "requirement",
        "affected_regimes",
        "closure_evidence",
        "blocking_scope",
        "specification_disposition"
      ]
    }
  },
  "evidence_before_use_rule": {
    "listed_ids": "ALL_LISTED_IDS_MUST_BE_CANONICAL_PRESENT_AND_INDEPENDENTLY_VALIDATED_BEFORE_AFFECTED_WORK",
