{
  "schema": "neo-harness-requirement-traceability-v2",
  "current_status": "AUTHOR_COMPLETE_AWAITING_INDEPENDENT_REVIEW",
  "macroscopic_objective": "Map every governing requirement and dependency to the requested NeoHunter product, evidence required before use, canonical harness outputs, and acceptance-test families without implementation or scientific execution.",
  "workflow_definitions": {
    "product_workflows": {
      "WF-CONTROL": "Spec Prompt, context routing, authority, immutable inputs, roles, and stop gates.",
      "WF-SHELL": "NeoHunter slash-command shell, autocomplete, terminal presentation, and command dispatch.",
      "WF-NEW-SEARCH": "New Search planning, bounded source and method selection, execution-state creation, and progress presentation.",
      "WF-REVIEW-LOGS": "Review Search Logs inspection, filtered-grid queries, evidence review, and operator selection.",
      "WF-FOLLOW-ON": "Operator-selected Follow-On Search using retained evidence and explicit authorization.",
      "WF-EXIT": "Safe CLI exit with state preservation and no hidden work.",
      "WF-DATA-INTAKE": "Provider registry, access authorization, credential-reference interfaces, product identity, and normalized intake.",
      "WF-PERSIST": "Search-result, intermediate-evidence, filter-query, run-state, and recovery persistence.",
      "WF-OPS": "Deterministic non-LLM workers, shards, resources, telemetry, restart, retention, and recovery.",
      "WF-EVALUATION": "Outcome-blind bounded comparison, metrics, uncertainty, adversarial review, and production-selection evidence.",
      "WF-DISPOSITION": "Rejection, reclassification, follow-up, independent verification, and operator-gated packaging.",
      "WF-HANDOFF": "Evidence-complete Codex CLI implementation assignment and later operator-gated disposition handoffs."
    },
    "subordinate_scientific_workflows": {
      "WF-POINT": "Point-like pixel opportunity detection and evidence collection.",
      "WF-TRAIL": "Trailed-source pixel opportunity detection and uncertainty propagation.",
      "WF-ASSOCIATION": "Catalog or alert-record association with retained ambiguity and lineage.",
      "WF-TRACKLET": "Single-night tracklet formation with two-detection and three-or-more strata.",
      "WF-LINKING": "Multi-night and cross-survey linking with normalization, rare-regime retention, and multimodality.",
      "WF-HISTORICAL": "Targeted historical recovery or precovery kept separate from blind archival discovery.",
      "WF-ORBIT": "Initial-orbit family and uncertainty handling without impact disposition."
    },
    "subordination_rule": "EVERY_BINDING_HAS_AT_LEAST_ONE_PRODUCT_WORKFLOW; SCIENTIFIC_WORKFLOWS_NEVER_STAND_ALONE_OR_BECOME_ROADMAP_PHASES"
  },
  "output_sets": {
    "OS-CONTROL": [
      "AGENTS.md",
      "configs/harness/harness-charter.json",
      "configs/harness/roadmap.json",
      "docs/runbook/HARNESS_BUILD_RUNBOOK.md"
    ],
    "OS-HANDOFF": [
      "docs/harness/CODEX_CLI_HANDOFF.md"
    ],
    "OS-INDEX": [
      "configs/harness/roadmap-index.json",
      "docs/harness/HARNESS_INDEX.md",
      "configs/harness/traceability.json",
      "docs/harness/REQUIREMENT_TRACEABILITY.md"
    ],
    "OS-REVIEW": [
      "docs/harness/ADVERSARIAL_REVIEW.md"
    ],
    "OS-SCHEMA": [
      "configs/harness/schemas"
    ],
    "OS-SOURCE": [
      "docs/harness/SOURCE_REGISTRY.csv"
    ],
    "OS-SPEC": [
      "docs/harness/HARNESS_SPECIFICATION.md"
    ],
    "OS-STATUS": [
      "configs/harness/requirements.json",
      "docs/harness/HARNESS_STATUS.md"
    ]
  },
  "acceptance_test_families": {
    "AT-CONTROL": "Exact repository, authority, role, immutable inputs, and prohibited-action boundaries are enforced before work.",
    "AT-DATA": "The affected data interface has verified identity, fields, units, frames, missingness, access limits, and fail-closed behavior.",
    "AT-DISPOSITION": "Every candidate disposition preserves ambiguity, evidence, operator authority, and prohibited scientific or operational claims.",
    "AT-HANDOFF": "The implementation step is bound to closed requirements and prevalidated evidence and requires no research or invention.",
    "AT-LABEL": "Labels, splits, cutoffs, roles, unknown states, and leakage controls are explicit and independently testable.",
    "AT-METHOD": "The method has exact equations, inputs, units, frames, ordering, uncertainty, numerical behavior, invalid behavior, and evidence limits.",
    "AT-METRIC": "Denominators, strata, uncertainty, calibration, power, multiplicity, thresholds, and zero-denominator behavior are outcome-blind and explicit.",
    "AT-OPERATIONS": "Resource, retry, retention, restart, telemetry, network, and failure behavior are deterministic and bounded.",
    "AT-PRODUCT": "The user-visible command or state transition has exact prerequisites, parameters, outputs, reason codes, recovery, and UX behavior.",
    "AT-REVIEW": "A fresh role-separated reviewer rejects novel unsafe in-family mutations and accepts matched legitimate controls without repairing the target.",
    "AT-TRACE": "Every source ID appears exactly once and resolves to product workflows, subordinate scientific workflows, output sets, evidence prerequisites, and tests."
  },
  "source_profiles": {
    "SP-OPR": {
      "path": "configs/harness/requirements.json",
      "id_field": "id",
      "controlling_fields": [
        "status",
        "topic"
      ]
    },
